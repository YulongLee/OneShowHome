; Engine configuration file.
; OneShow Home — Indoor Game Runtime

config_version=5

[application]

config/name="OneShow Home World"
run/main_scene="res://scenes/home/home_world.tscn"
config/features=PackedStringArray("4.6", "GL Compatibility")

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/size/window_width_override=1280
window/size/window_height_override=720
window/stretch/mode="canvas_items"

[input]

move_left={
"deadzone": 0.3,
"events": [Object(InputEventKey,"physical_keycode":65), Object(InputEventKey,"physical_keycode":4194311)]
}
move_right={
"deadzone": 0.3,
"events": [Object(InputEventKey,"physical_keycode":68), Object(InputEventKey,"physical_keycode":4194313)]
}
move_up={
"deadzone": 0.3,
"events": [Object(InputEventKey,"physical_keycode":87), Object(InputEventKey,"physical_keycode":4194320)]
}
move_down={
"deadzone": 0.3,
"events": [Object(InputEventKey,"physical_keycode":83), Object(InputEventKey,"physical_keycode":4194322)]
}
interact={
"deadzone": 0.3,
"events": [Object(InputEventKey,"physical_keycode":69), Object(InputEventKey,"physical_keycode":32)]
}
switch_living_room={
"deadzone": 0.3,
"events": [Object(InputEventKey,"physical_keycode":49)]
}
switch_kitchen={
"deadzone": 0.3,
"events": [Object(InputEventKey,"physical_keycode":50)]
}
switch_bedroom={
"deadzone": 0.3,
"events": [Object(InputEventKey,"physical_keycode":51)]
}

[layer_names]

2d_physics/layer_1="World"
2d_physics/layer_2="Player"
2d_physics/layer_3="Interactable"
2d_physics/layer_4="Buddy"

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/default_filters/use_nearest_mipmap_filter=false

