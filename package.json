{
  "name": "oneshow-home",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.16.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm --filter @oneshow/desktop tauri dev",
    "dev:api": "pnpm --filter @oneshow/api dev",
    "dev:web": "npm --prefix apps/web run dev",
    "build": "pnpm --filter @oneshow/desktop tauri build",
    "build:web": "npm --prefix apps/web run build",
    "build:app": "pnpm --filter @oneshow/desktop tauri build --bundles app",
    "format": "pnpm --filter @oneshow/desktop format",
    "format:check": "pnpm --filter @oneshow/desktop format:check",
    "lint": "pnpm --filter @oneshow/desktop lint",
    "typecheck": "pnpm --filter @oneshow/desktop typecheck && pnpm --filter @oneshow/api typecheck",
    "test": "pnpm --filter @oneshow/desktop test && pnpm --filter @oneshow/api test",
    "build:api": "pnpm --filter @oneshow/api build",
    "game:edit": "godot --path game --editor",
    "game:dev": "godot --path game",
    "game:check": "godot --headless --path game --script res://tests/runtime_test.gd",
    "game:build": "godot --headless --path game --export-debug macOS",
    "rust:fmt": "cargo fmt --manifest-path apps/desktop/src-tauri/Cargo.toml --check",
    "rust:clippy": "cargo clippy --manifest-path apps/desktop/src-tauri/Cargo.toml --all-targets -- -D warnings",
    "rust:test": "cargo test --manifest-path apps/desktop/src-tauri/Cargo.toml",
    "verify": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test && pnpm rust:fmt && pnpm rust:clippy && pnpm rust:test"
  }
}
