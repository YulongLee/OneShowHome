ONESHOW_HOME_API_HOST=127.0.0.1
ONESHOW_HOME_API_PORT=8793
ONESHOW_HOME_DATABASE_URL=postgresql://oneshowhome:replace-me@127.0.0.1:5432/oneshowhome
ONESHOW_HOME_ALLOWED_ORIGINS=tauri://localhost,http://tauri.localhost,http://127.0.0.1:1420

# Production: invoke the model through the encrypted OneShowTools Admin gateway.
ONESHOW_HOME_MODEL_GATEWAY_URL=http://127.0.0.1:8787/api/internal/v1/platform-model/invoke
ONESHOW_HOME_MODEL_GATEWAY_TOKEN=replace-with-a-random-service-token

# Local-only fallback for testing before the Admin gateway is available.
# Never expose these values through VITE_ variables or commit real credentials.
ONESHOW_HOME_CHAT_BASE_URL=https://example.invalid/v1
ONESHOW_HOME_CHAT_API_KEY=replace-me
ONESHOW_HOME_CHAT_MODEL=replace-me
ONESHOW_HOME_MODEL_PURPOSE=oneshow_home_chat
ONESHOW_HOME_MODEL_TIMEOUT_MS=45000
